# ─────────────────────────────────────────────────────────────────────────────
# Sonali Paithani — environment template.
#
# Local development: copy to `server/.env` and run `npm run dev`. Every value has
# a safe fallback, so an empty file boots on in-memory Postgres with the demo
# catalogue. Never commit the real file — `.gitignore` already excludes it.
#
# Going live on a domain: work through DEPLOY.md, then confirm with
# `npm run deploy:check`, which reports exactly what is still unsafe.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Leave empty for local dev: the API then runs on an
# in-memory Postgres and seeds the demo catalogue, but every product, enquiry and
# stock change is erased when the process restarts.
# Supabase → Project Settings → Database → Connection string → URI.
# Neon, Railway and Render Postgres all work too.
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRE IN PRODUCTION. Signs admin dashboard sessions; anyone holding it can
# mint an admin token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Seeds the admin account on the FIRST boot only — once the row exists,
# `ensureAdminUser()` leaves it alone, so changing this later has no effect.
# Change the password from the dashboard instead (Settings → Dashboard
# password). Set it here before the very first production boot.
ADMIN_EMAIL=admin@sonalipaithani.com
ADMIN_PASSWORD=

# ─── Server ──────────────────────────────────────────────────────────────────
# Most hosts inject PORT. Must be > 0; 0/empty falls back to 4000.
PORT=4000

# Browsers allowed to call the API. REQUIRED IN PRODUCTION — set it to the real
# origin, comma-separating extras: https://sonalipaithani.com,https://www.sonalipaithani.com
# Leaving the localhost default in place blocks your live domain.
CORS_ORIGIN=http://localhost:3000

# Public origin used in links that leave this server: the payment QR a customer
# taps from WhatsApp, plus the canonical and og:image tags crawlers read.
# Empty is fine for a single-host deploy (express falls back to the host the
# request arrived on) — set it explicitly once DNS is live:
PUBLIC_BASE_URL=

# How many reverse proxies sit in front of Node. 1 = Render/Railway/Fly/Heroku/
# Cloudflare/nginx (the usual case). Set 0 when Node is exposed directly to the
# internet. This one matters: it decides whether rate limits see real client IPs
# and whether https links are generated correctly.
TRUST_PROXY=1

# ─── Abuse controls ──────────────────────────────────────────────────────────
# On by default. Windows are fixed-length and counted per client IP.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_ENQUIRY_MAX=20
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOOKUP_MAX=60
# RATE_LIMIT_DISABLED=true

# ─── Seed data ───────────────────────────────────────────────────────────────
# Runs only against an empty catalogue, so this must be set BEFORE the first
# boot against a fresh production database.
# true  → demo sarees, collections and both photo & video galleries
# false → empty shop, ready for real products
SEED_DEMO_DATA=true

# ─── Store identity (used to build customer WhatsApp messages) ───────────────
STORE_NAME=Sonali Paithani
STORE_ADDRESS=Sonali Paithani, Yeola, Nashik - 423401
STORE_PHONE=919822055443
STORE_WHATSAPP=919822055443
STORE_EMAIL=yeola@sonalipaithani.com
# The UPI VPA the payment QR encodes. Copy it from the shop owner's UPI app —
# a placeholder here means customers scan a QR that pays nobody.
STORE_UPI=
DEFAULT_COUNTRY_CODE=91

# ─── Image storage ───────────────────────────────────────────────────────────
# REQUIRED unless the host gives you a persistent disk. Without these, uploads
# are written to ./uploads on the container filesystem and disappear on the next
# deploy. Supabase → Project Settings → API. The bucket must be PUBLIC or the
# saved image URLs return 403.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# Escape hatch: set to true only when ./uploads really is a mounted volume.
# ALLOW_EPHEMERAL_UPLOADS=true

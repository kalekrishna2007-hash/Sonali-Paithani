    "start": "node server/index.js",
    "typecheck": "tsc --noEmit && node --check server/index.js",
    "test": "node --test server/tests/*.test.js",
    "deploy:check": "node scripts/deploy-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "pg-mem": "^3.0.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
